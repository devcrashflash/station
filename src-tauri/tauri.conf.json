{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Station by DevCrashFlash",
  "version": "0.10.7",
  "identifier": "com.devcrashflash.station",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$HOME/**",
            "$TEMP/**"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "legal/LICENSE",
      "../COMMERCIAL_LICENSE.md": "legal/COMMERCIAL_LICENSE.md",
      "../THIRD_PARTY_NOTICES.md": "legal/THIRD_PARTY_NOTICES.md"
    }
  }
}
